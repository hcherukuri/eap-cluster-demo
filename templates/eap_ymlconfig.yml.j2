wildfly-configuration:
  system-property:
    JBOSS_ID:
      value: {{ inventory_hostname }}
  socket-binding-group:
    standard-sockets:
      remote-destination-outbound-socket-binding:
{% for node in eap_cluster_nodes %}
        {{ node.address }}:
          host: "{{ node.value }}"
          port: 7600
{% endfor %}
  subsystem:
    jgroups:
      stack:
        tcp:
          transport:
            TCP:
              socket-binding: jgroups-tcp
          protocol:
            MPING: !remove
          protocol:
            TCPPING:
              add-index: 0
              socket-bindings:
{% for node in eap_cluster_nodes %}
                - {{ node.address }}
{% endfor %}
              properties:
                initial_hosts: "{{ eap_cluster_nodes | map(attribute='inventory_host') | join(',') }}"
                port_range: 0
      channel:
        ee:
          stack: tcp
